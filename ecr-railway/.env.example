# Copiá este archivo a .env y completá con los datos de Railway
# (Railway → bloque MySQL → pestaña Variables)
MYSQLHOST=tu_host_de_railway
MYSQLDATABASE=railway
MYSQLUSER=root
MYSQLPASSWORD=tu_contraseña
MYSQLPORT=3306
PORT=3000

# Clave para firmar las sesiones (una frase larga y aleatoria). Obligatoria en producción.
APP_SECRET=

# Dirección pública del sistema, para los enlaces de los mails (opcional; si falta se usa la del pedido)
APP_URL=https://ecr-sistema.up.railway.app

# IA (Google Gemini): asistente y lectura de extractos
GEMINI_API_KEY=

# Mails (alertas al estudio, activación de cuentas y cambio de contraseña)
ALERTAS_MAIL_PARA=
ALERTAS_WEBHOOK_URL=
ALERTAS_WEBHOOK_SECRET=
# ALERTAS_PAUSADAS=1   pausa SOLO las alertas de vencimientos (los mails de activación siguen saliendo)

# Copia de seguridad automática (clave larga, 24 caracteres o más). Sin esta variable solo hay copia manual.
BACKUP_TOKEN=
